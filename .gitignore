# --- StandupBot .gitignore ---

# User-specific config and runtime data
.standup.json
.standup_usage.json
.standup_history.db
.standup_history.db-wal
.standup_history.db-shm
.standup.log
.standup.log.*

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Environment
.env
.env.*
.venv/
venv/
env/

# Testing
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
junit.xml
htmlcov/

# Graphify knowledge graph cache
graphify-out/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
