# Force LF line endings for all text files so ruff format --check
# produces the same result on Windows and Linux CI.
* text=auto eol=lf

# Explicitly enforce LF for source files
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
